  m_Script: {fileID: 11500000, guid: a8709feaec63a6a4e81ceac2b530cd48, type: 3}
  m_Name: Level_163
  m_EditorClassIdentifier: Assembly-CSharp::KidGame.Interface.LevelData
  levelNumber: 163
  levelName: LESSON 163
  levelSubtitle: Greater or Less
  levelEndTip: 3 apples is greater than 2 bananas
  isUnlockedByDefault: 1
  isPremadeLevel: 0
  themePresetName: Green
  levelThemeColor: {r: 0.32156864, g: 0.83921576, b: 0.46274513, a: 0}
  levelBackgroundSprite: {fileID: 21300000, guid: 5d277dfec57dacf49b1ef3fcecda1b5b, type: 3}
  pages:
  - gameType: 2
    overrideLevelPremade: 0
    dialogueLines:
    - text: Hello {playername} let's compare numbers
      mascotAnimationTrigger: isHi
    - text: This is the greater than comparison symbol ">".
      mascotAnimationTrigger: isIdle
    - text: We say a number is greater than another numer if it is bigger
      mascotAnimationTrigger: isIdle
    - text: 'For example 4 is bigger than 2, so we say 4 is greater than 2 '
      mascotAnimationTrigger: isIdle
    - text: So we write 4 > 2
      mascotAnimationTrigger: isIdle
    - text: 'Since 4 is bigger than 2 that means 2 is smaller than 4, so we say 2
        is less than 4 '
      mascotAnimationTrigger: isIdle
    - text: This is the less than comparison symbol "<", so we write 2 < 4
      mascotAnimationTrigger: isIdle
    - text: If we have two number that are the same size, we say they are equal
      mascotAnimationTrigger: isIdle
    - text: This is the equal symbol "=".
      mascotAnimationTrigger: isIdle
    - text: If 2 + 2 is equal to 4 then we write 2 + 2 = 4
      mascotAnimationTrigger: isIdle
    - text: Count the objects on the left and count the object on the right in each
        row
      mascotAnimationTrigger: isIdle
    - text: Which one is greater or lesser or are they eqaul
      mascotAnimationTrigger: isIdle
    - text: Put the correct comparison symbol into their middle box
      mascotAnimationTrigger: isIdle
    - text: If you count 10 balls on the left and 5 cakes on the right, 10 is bigger
        than 5
      mascotAnimationTrigger: isIdle
    - text: So you put the > symbol into the box
      mascotAnimationTrigger: isIdle
    - text: Alright {playername} Let's compare!
      mascotAnimationTrigger: isHappy
    completionDialogueLines:
    - text: Very Good!
      mascotAnimationTrigger: isHappy
    - text: You are now familiar with comparing numbers!
      mascotAnimationTrigger: isIdle
    - text: Count objects around you and keep comparing their numbers
      mascotAnimationTrigger: isIdle
    countingSlotCount: 5
